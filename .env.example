APP_NAME="Dynamic QR Social Profile SaaS"
APP_ENV=local
APP_KEY=base64:DynamicQRSaaSKeyPlaceholder2026Base64=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qr_profile_saas
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@qr-identity.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe Payment Credentials
STRIPE_KEY=pk_test_placeholder_stripe_key
STRIPE_SECRET=sk_test_placeholder_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_placeholder_stripe_webhook

# Razorpay Payment Credentials
RAZORPAY_KEY=rzp_test_placeholder_key
RAZORPAY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Object Storage Credentials (S3 / Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SANCTUM API CORS & STATEFUL DOMAINS
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:8000,127.0.0.1"
