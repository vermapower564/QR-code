{
    "builds":  [
                   {
                       "src":  "api/index.php",
                       "use":  "vercel-php@0.6.2"
                   },
                   {
                       "src":  "/public/**",
                       "use":  "@vercel/static"
                   }
               ],
    "routes":  [
                   {
                       "src":  "/build/(.*)",
                       "dest":  "/public/build/"
                   },
                   {
                       "src":  "/(.*)",
                       "dest":  "/api/index.php"
                   }
               ]
}
